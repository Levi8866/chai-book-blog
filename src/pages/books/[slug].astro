---
import fs from 'node:fs';
import path from 'node:path';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { all } from '../../data/books.js';

export function getStaticPaths() {
  return all.map(b => ({ params: { slug: b.slug }, props: b }));
}
const { slug, title, author, summary, date } = Astro.props;

// 读取该书拆书正文
const booksDir = path.join(process.env.HOME, '.openclaw/workspace/books', slug);
const files = fs.existsSync(booksDir) ? fs.readdirSync(booksDir) : [];
let mdFile = files.find(f => f === 'LIGHT_notes.md')
  || files.find(f => f.endsWith('formatted.md'))
  || files.find(f => f.endsWith('.md') && f !== 'models.md');
let html = '';
if (mdFile) {
  const md = fs.readFileSync(path.join(booksDir, mdFile), 'utf-8');
  const processor = await createMarkdownProcessor();
  html = (await processor.render(md)).code;
}
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={summary || title} />
    <title>{title} · 拆书沉浮</title>
    <style>
      :root { --bg:#fafafa; --fg:#1f2937; --accent:#7c3aed; --muted:#6b7280; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--fg); font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; line-height:1.85; }
      header { border-bottom:1px solid #e5e7eb; padding:22px 24px; background:#fff; }
      .wrap { max-width:780px; margin:0 auto; padding:0 20px; }
      .back { color:var(--accent); text-decoration:none; font-size:.9rem; }
      h1 { font-size:1.7rem; margin:14px 0 6px; }
      .meta { color:var(--muted); font-size:.88rem; margin-bottom:10px; }
      .summary { color:#374151; background:#f3f4f6; padding:12px 16px; border-radius:8px; font-size:.95rem; }
      article { padding:30px 0; }
      article :is(h1,h2,h3) { line-height:1.4; margin-top:1.6em; color:var(--fg); }
      article h2 { border-bottom:1px solid #eee; padding-bottom:6px; }
      article table { border-collapse:collapse; width:100%; margin:16px 0; font-size:.92rem; }
      article th, article td { border:1px solid #e5e7eb; padding:8px 10px; text-align:left; }
      article th { background:#f9fafb; }
      article blockquote { border-left:3px solid var(--accent); margin:14px 0; padding:6px 16px; color:#374151; background:#f8f7fd; }
      article code { background:#f3f4f6; padding:2px 5px; border-radius:4px; font-size:.9em; }
      footer { border-top:1px solid #e5e7eb; padding:20px; text-align:center; color:#9ca3af; font-size:.85rem; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="back" href="/">&larr; 返回全部拆书</a>
        <h1>{title}</h1>
        <div class="meta">{author}{author && date ? ' · ' : ''}{date}</div>
        {summary && <div class="summary">{summary}</div>}
      </div>
    </header>
    <article class="wrap" set:html={html}>
      {(html === '' ) ? '<p style="color:#9ca3af">（未找到拆书正文）</p>' : ''}
    </article>
    <footer>© Levi · 拆书沉浮</footer>
  </body>
</html>
